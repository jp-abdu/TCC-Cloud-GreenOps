{
  "name": "Microsservicos com Lambda",
  "description": "Arquitetura de microsservicos combinando EC2 para servicos pesados e Lambda para handlers leves e eventos. Dois servicos independentes com banco compartilhado.",
  "base_region": "us-east-1",
  "components": [
    {
      "type": "ec2",
      "instance": "m5.xlarge",
      "hours": 730,
      "cpu": 0.50,
      "os": "Linux",
      "note": "Servico A — processamento de pedidos"
    },
    {
      "type": "ec2",
      "instance": "m5.large",
      "hours": 730,
      "cpu": 0.45,
      "os": "Linux",
      "note": "Servico B — gestao de usuarios e perfis"
    },
    {
      "type": "lambda",
      "invocations": 20000000,
      "duration_ms": 80,
      "memory_mb": 256,
      "architecture": "x86",
      "note": "Auth, notificacoes e eventos — 20M inv/mes"
    },
    {
      "type": "rds",
      "instance": "db.m5.large",
      "hours": 730,
      "cpu": 0.40,
      "engine": "MySQL",
      "multi_az": true,
      "note": "Banco principal Multi-AZ compartilhado"
    }
  ]
}
