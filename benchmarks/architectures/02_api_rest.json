{
  "name": "API REST Media Escala",
  "description": "API REST com multiplas instancias, banco PostgreSQL Multi-AZ, cache em memoria e processamento assincrono via Lambda. Tipico de SaaS em crescimento.",
  "base_region": "us-east-1",
  "components": [
    {
      "type": "ec2",
      "instance": "m5.large",
      "hours": 730,
      "cpu": 0.55,
      "os": "Linux",
      "note": "Instancia 1 — API server"
    },
    {
      "type": "ec2",
      "instance": "m5.large",
      "hours": 730,
      "cpu": 0.55,
      "os": "Linux",
      "note": "Instancia 2 — API server"
    },
    {
      "type": "ec2",
      "instance": "m5.large",
      "hours": 730,
      "cpu": 0.55,
      "os": "Linux",
      "note": "Instancia 3 — API server"
    },
    {
      "type": "ec2",
      "instance": "r5.large",
      "hours": 730,
      "cpu": 0.40,
      "os": "Linux",
      "note": "Cache node — memory optimized para sessoes e dados frequentes"
    },
    {
      "type": "rds",
      "instance": "db.m5.large",
      "hours": 730,
      "cpu": 0.45,
      "engine": "PostgreSQL",
      "multi_az": true,
      "note": "Banco PostgreSQL Multi-AZ"
    },
    {
      "type": "lambda",
      "invocations": 5000000,
      "duration_ms": 100,
      "memory_mb": 256,
      "architecture": "x86",
      "note": "Notificacoes, webhooks e processamento assincrono"
    }
  ]
}
