{
  "name": "Arquitetura Serverless",
  "description": "API serverless com Lambda e banco gerenciado. Tipico de aplicacoes event-driven e microsservicos leves.",
  "base_region": "us-east-1",
  "components": [
    {
      "type": "lambda",
      "invocations": 10000000,
      "duration_ms": 150,
      "memory_mb": 512,
      "architecture": "x86",
      "note": "API handler — 10M invocacoes/mes, 150ms media"
    },
    {
      "type": "rds",
      "instance": "db.t3.medium",
      "hours": 730,
      "cpu": 0.20,
      "engine": "MySQL",
      "multi_az": false,
      "note": "Banco de dados"
    }
  ]
}
